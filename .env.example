# Chợ Tốt CLI Environment Configuration
# Copy this file to .env and adjust variables as needed

# Chợ Tốt Gateway API Base URL
CHOTOT_BASE_URL=https://gateway.chotot.com

# HTTP/HTTPS Proxy URL (e.g., http://user:pass@proxy.example.com:8080)
# Set to 'direct' or 'none' to bypass proxies
CHOTOT_PROXY=

# Automatically engage proxy fallback when encountering rate limits or geoblocks (0 or 1)
CHOTOT_AUTO_PROXY=0

# Custom command to resolve residential proxy URL for geo-targeted exit (stdout must print proxy URL)
CHOTOT_PROXY_RESOLVER=
